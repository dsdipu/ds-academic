# DS Academic — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================
# YouTube Data API v3
# Get from: https://console.cloud.google.com
# ============================================
REACT_APP_YOUTUBE_API_KEY=your_youtube_api_key_here
REACT_APP_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx

# ============================================
# Google Analytics 4
# Get from: https://analytics.google.com
# ============================================
# Add to docusaurus.config.js gtag section instead:
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# Algolia Search (Optional)
# Get from: https://www.algolia.com
# Free tier available for open source projects
# ============================================
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_search_only_api_key
ALGOLIA_INDEX_NAME=ds-academic
